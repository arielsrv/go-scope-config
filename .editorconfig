; https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[{go.mod,go.sum,go.work,go.work.sum,*.go,.gitmodules}]
indent_style = tab
tab_width = 4

[{*.yml,*.yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_size = 4
trim_trailing_whitespace = false
max_line_length = off
